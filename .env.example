# Copy to .env and fill in. Never commit .env.
ER_ENVIRONMENT=production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ER_SECRET_KEY=
# Generate: python -m app.cli gen-key   (losing this key makes all stored documents unreadable — back it up securely)
ER_STORAGE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Local development only (overridden by docker-compose):
# ER_DATABASE_URL=sqlite:///./data/app.db

ER_OPERATOR_NAME=Factuurspoor
ER_OPERATOR_EMAIL=info@example.nl
ER_DEFAULT_RETENTION_DAYS=365
# Optional prefill for the fee field at intake; every client still stores its own agreed percentage.
# ER_DEFAULT_SUCCESS_FEE_PERCENTAGE=15

# Detection tolerances (defaults shown)
# ER_LINE_AMOUNT_TOLERANCE=0.02
# ER_TOTAL_TOLERANCE=0.05
# ER_MIN_POTENTIAL_RECOVERY=0.50
# ER_PERIOD_BOUNDARY_TOLERANCE_DAYS=1

# AI stays off unless a processor agreement covers it AND the client consented.
ER_AI_ENABLED=false

# Optional CRM webhook (https only). Receives lead metadata, never invoice data.
# ER_LEAD_WEBHOOK_URL=https://...

# ---- Lead generation workflow -------------------------------------------------
# Research source: openstreetmap = real Dutch companies (needs internet, no API key) | mock = clearly marked test data
ER_RESEARCH_PROVIDER=openstreetmap
# ER_RESEARCH_USER_AGENT=YourCompany-LeadResearcher/1.0 (+https://yourdomain.nl; you@yourdomain.nl)
# ER_RESEARCH_APPROVAL_THRESHOLD=50
# ER_LEAD_QUALIFY_THRESHOLD=55

# E-mail provider: mock = nothing leaves this computer (default) | smtp = LIVE (SMTP to send, IMAP to read replies)
ER_EMAIL_PROVIDER=mock
ER_OUTREACH_FROM_NAME=Team Factuurspoor
# ER_OUTREACH_FROM_EMAIL=sales@yourdomain.nl
# ER_SMTP_HOST=smtp.yourprovider.nl
# ER_SMTP_PORT=587
# ER_SMTP_USER=
# ER_SMTP_PASSWORD=
# ER_SMTP_STARTTLS=true
# ER_IMAP_HOST=imap.yourprovider.nl
# ER_IMAP_PORT=993
# ER_IMAP_USER=
# ER_IMAP_PASSWORD=
# ER_IMAP_FOLDER=INBOX
# ER_INBOX_POLL_MINUTES=5
# ER_FOLLOW_UP_DAYS=7
